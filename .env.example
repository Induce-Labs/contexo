# Copy to .env files per app. Never commit real secrets.

# Shared / local development
ENVIRONMENT=development
DEBUG=true

# FastAPI (apps/api/.env)
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=
NEON_AUTH_BASE_URL=

# Next.js public (safe to expose) — apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Neon Auth (server-only — never NEXT_PUBLIC_)
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32 ; apps/web only

# Object storage and provider OAuth tokens stay server-side only.
# Do not prefix secrets with NEXT_PUBLIC_.
